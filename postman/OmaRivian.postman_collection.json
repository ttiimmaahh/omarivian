        }
      ]
    },
    {
      "name": "Optional sensitive data",
      "description": "Run only when location access is intentionally enabled.",
      "item": [
        {
          "name": "Get vehicle location (sensitive)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "User-Agent",
                "value": "RivianApp/707 CFNetwork/1237 Darwin/20.4.0"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Apollographql-Client-Name",
                "value": "com.rivian.ios.consumer-apollo-ios"
              },
              {
                "key": "dc-cid",
                "value": "m-ios-{{$guid}}"
              },
              {
                "key": "A-Sess",
                "value": "{{appSessionToken}}"
              },
              {
                "key": "Csrf-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "U-Sess",
                "value": "{{userSessionToken}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"operationName\":\"GetVehicleLocation\",\"query\":\"query GetVehicleLocation($vehicleID: String!) { vehicleState(id: $vehicleID) { gnssLocation { timeStamp latitude longitude isAuthorized } } }\",\"variables\":{\"vehicleID\":\"{{vehicleId}}\"}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "https://rivian.com/api/gql/gateway/graphql",
